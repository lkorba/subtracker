# Supabase configuration for subtracker
# Copy to .env and fill in, or set as Netlify env vars for production.

# Project ID (the part before .supabase.co)
SUPABASE_PROJECT_ID="your-project-ref"

# Public URL — same for all envs
SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# NEW Supabase key format (preferred for new projects).
# Get these from Supabase Dashboard > Project Settings > API Keys
# - publishable key is the "publishable" key (sb_publishable_...)
# - secret key is the "secret" key (sb_secret_...) — SERVER-ONLY, never expose
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
